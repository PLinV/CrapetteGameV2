# Copier ce fichier en .env (à la racine pour la production, dans backend/ pour le dev)
# et remplir les valeurs. Ne jamais commiter le .env.

# ---- Production uniquement ----
# Nom de domaine du site, ex : crapette.mondomaine.fr
DOMAIN=
# Image Docker de l'appli (construite par GitHub Actions), ex : ghcr.io/plinv/crapettegamev2:1.0.0
APP_IMAGE=
# Réglages du Traefik du serveur (à demander à son administrateur)
TRAEFIK_NETWORK=traefik
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt

# Base de données
POSTGRES_USER=crapette_admin
POSTGRES_PASSWORD=
POSTGRES_DB=crapette_db

# Secrets : générer chacun avec  openssl rand -hex 32
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
# Ajouté aux mots de passe avant hachage. Ne plus jamais le changer une fois des comptes créés.
PEPPER=

# ---- Optionnel ----
# Temps (en secondes) laissé à un joueur qui quitte une partie pour revenir avant de perdre par forfait (défaut : 360).
# FORFEIT_DELAY_SECONDS=360
